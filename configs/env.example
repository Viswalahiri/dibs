# Dibs secrets. Copy to ~/.config/dibs/env and chmod 600.
#
# This file is read by systemd (EnvironmentFile) and by your shell:
#   set -a; . ~/.config/dibs/env; set +a
#
# No quotes, no export, no spaces around the equals sign. systemd is strict.

# Fine-grained personal access token, read-only, public repositories.
# github.com/settings/personal-access-tokens/new
#   Repository access: Public repositories (read-only)
#   Expiration:        whatever you are willing to rotate
# Dibs never writes to GitHub, so no write permission is ever needed.
DIBS_GITHUB_TOKEN=

# Anthropic API key. console.anthropic.com/settings/keys
# Only needed once triage is running. Leave blank for --dry-run polling.
DIBS_ANTHROPIC_KEY=

# Slack bot token, starts with xoxb-. Not needed with --dry-run.
DIBS_SLACK_BOT_TOKEN=

# Slack app-level token, starts with xapp-, scope connections:write.
# Not needed with --dry-run.
DIBS_SLACK_APP_TOKEN=

# Optional overrides. Delete these lines to accept the defaults.
# DIBS_CONFIG=~/.config/dibs/dibs.yaml
# DIBS_DB=~/.local/share/dibs/dibs.db
